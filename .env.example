# Copy this file to .env and fill in real values.
# NEVER commit .env — it is listed in .gitignore.

# Application Settings
PROJECT_NAME=Disease Risk Predictor
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-256-bit-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (Neon or any PostgreSQL)
# Sync URL — used by FastAPI + Alembic
NEON_DB_URL=postgresql://user:password@host/dbname?sslmode=require
# Async URL — used by Celery async engine (postgresql+asyncpg://)
NEON_ASYNC_DB_URL=postgresql+asyncpg://user:password@host/dbname

# Redis Configuration
# For local Docker: redis://redis:6379/0
# For production (e.g. Redis Cloud / Upstash): rediss://user:password@host:port/0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Razorpay — get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
